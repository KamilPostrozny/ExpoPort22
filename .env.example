# No app environment variables or secrets are required. Configure the SSH host in the app.
# Do not copy this file into .env unless adding an actual local override.

# Expo CLI supplies EXPO_BASE_URL for DOM font URLs (src/terminal.tsx); leave unset locally.
# EXPO_BASE_URL=

# Optional shell override for IPA download staging; scripts/install-variant.sh defaults to /tmp.
# TMPDIR=/tmp

# Device tools use the netmuxd socket under $HOME/.local/share/port22/nm.sock.
# Scripts set USBMUXD_SOCKET_ADDRESS themselves; xtool needs UNIX:, pymobiledevice3 must omit it.
# USBMUXD_SOCKET_ADDRESS=/absolute/path/to/nm.sock

# GitHub Actions supplies GH_TOKEN from github.token for publishing; local gh uses gh auth login.
# GH_TOKEN=
