{
  "expo": {
    "name": "Port22",
    "slug": "ExpoPort22",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "expoport22",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kamilpostrozny.port22",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Port22 uses the camera so you can upload a photo you take now to the machine you are attached to.",
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "com.kamilpostrozny.port22",
      "adaptiveIcon": {
        "backgroundColor": "#11111b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dce0e8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#11111b",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Port22 shows your photo library so you can upload a photo or video to the machine you are attached to.",
          "cameraPermission": "Port22 uses the camera so you can upload a photo you take now to the machine you are attached to.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          },
          "android": {
            "minSdkVersion": 28
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
